# CloudMind — SPA fallback cho Apache/LiteSpeed (Hostinger)
# Mọi đường dẫn không phải file/thư mục thật → trả index.html
# để React Router xử lý phía client (sửa lỗi 404 khi reload route sâu).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Bỏ qua các request tới file thật (js, css, ảnh, favicon...) và thư mục thật
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Còn lại → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Cache mạnh cho asset có hash (an toàn vì tên file đổi khi nội dung đổi)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|png|jpe?g|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html không cache để luôn lấy bản mới nhất
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Nén để tải nhanh hơn
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
